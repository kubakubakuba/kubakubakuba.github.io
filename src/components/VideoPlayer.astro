---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";

interface Props {
  title: string;
  src?: string;
  poster?: ImageMetadata;
  type?: string;
  label?: string;
  sourceLabel?: string;
  sourceUrl?: string;
}

const {
  title,
  src = "",
  poster,
  type = "video/mp4",
  label = "media://video",
  sourceLabel,
  sourceUrl,
} = Astro.props;

const posterUrl = poster ? (await getImage({ src: poster, format: "avif", width: 1280 })).src : undefined;
const hasSource = src.trim().length > 0;
---

<section class:list={["video-player", { "is-unavailable": !hasSource }]} data-video-player aria-label={title}>
  <div class="video-player__bar">
    <span class="video-player__label">{label}</span>
  </div>

  <div class="video-player__frame">
    {hasSource && (
      <video controls preload="metadata" playsinline poster={posterUrl}>
        <source src={src} type={type} />
        Your browser can't play this video.
      </video>
    )}
    <div class="video-player__placeholder" style={posterUrl ? `background-image: url(${posterUrl})` : undefined}>
      <span>Video coming soon</span>
    </div>
  </div>

  <div class="video-player__body">
    <h2 class="video-player__title">{title}</h2>
    {sourceUrl && (
      <a href={sourceUrl} target="_blank" rel="noreferrer">
        {sourceLabel ?? "Original source"} <Icon name="arrow-up-right" />
      </a>
    )}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-video-player]").forEach((root) => {
    const video = root.querySelector<HTMLVideoElement>("video");
    const source = video?.querySelector<HTMLSourceElement>("source");
    if (!video || !source) return;

    const markUnavailable = () => root.classList.add("is-unavailable");
    source.addEventListener("error", markUnavailable);
    // The source may already have failed before this deferred script ran.
    if (video.networkState === HTMLMediaElement.NETWORK_NO_SOURCE) markUnavailable();
  });
</script>

<style>
  .video-player {
    overflow: hidden;
    margin-block: 2.5rem 3.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    box-shadow: 0 18px 45px rgb(0 0 0 / 0.22);
  }

  .video-player__bar {
    display: flex;
    align-items: center;
    min-height: 38px;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid var(--line);
    background: var(--panel-soft);
    font: var(--text-2xs)/1.35 var(--mono);
  }

  .video-player__label {
    overflow: hidden;
    color: var(--muted-strong);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .video-player__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .video-player__frame video {
    display: block;
    width: 100%;
    height: 100%;
  }

  .video-player__placeholder {
    position: absolute;
    inset: 0;
    display: none;
    place-items: center;
    background: #000 center / cover no-repeat;
  }

  .video-player__placeholder::before {
    position: absolute;
    inset: 0;
    background: rgb(5 8 11 / 0.6);
    content: "";
  }

  .video-player__placeholder span {
    position: relative;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    color: var(--muted-strong);
    background: rgb(15 21 28 / 0.88);
    font: var(--text-xs)/1.25 var(--mono);
  }

  .video-player.is-unavailable video {
    display: none;
  }

  .video-player.is-unavailable .video-player__placeholder {
    display: grid;
  }

  .video-player__body {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: baseline;
    justify-content: space-between;
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .video-player .video-player__title {
    margin: 0;
    color: var(--text);
    font: 700 clamp(1rem, 2.5vw, 1.2rem)/1.35 var(--sans);
    letter-spacing: -0.015em;
  }

  .video-player__body a {
    color: var(--green);
    font: var(--text-xs)/1.45 var(--mono);
  }
</style>
