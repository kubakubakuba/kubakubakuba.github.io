---
import type { ImageMetadata } from "astro";
import PhotoGallery from "./PhotoGallery.astro";
import babyEagle from "../assets/images/photography/astro-01-baby-eagle.avif";
import vdb158 from "../assets/images/photography/astro-02-vdb158.avif";
import iris from "../assets/images/photography/astro-03-iris.avif";
import shark from "../assets/images/photography/astro-04-shark.avif";
import jellyfish from "../assets/images/photography/astro-05-jellyfish.avif";
import elephantsTrunk from "../assets/images/photography/astro-06-elephants-trunk.avif";
import heart from "../assets/images/photography/astro-07-heart.avif";
import casper from "../assets/images/photography/astro-08-casper.avif";
import horsehead from "../assets/images/photography/astro-09-horsehead.avif";
import orion from "../assets/images/photography/astro-10-orion.avif";
import cdCover from "../assets/images/photography/astro-cd-cover.avif";
import eclipsePalencia from "../assets/images/photography/eclipse-palencia.avif";
import eclipseSetup0 from "../assets/images/photography/eclipse-setup-0.avif";
import eclipseSetup1 from "../assets/images/photography/eclipse-setup-1.avif";
import eclipseSetup2 from "../assets/images/photography/eclipse-setup-2.avif";
import eclipseSetup3 from "../assets/images/photography/eclipse-setup-3.avif";

interface Photo {
  src: ImageMetadata;
  alt: string;
  caption: string;
  position?: string;
}

const deepSkyPhotos: Photo[] = [
  { src: babyEagle, alt: "The Baby Eagle Nebula surrounded by stars", caption: "Baby Eagle Nebula" },
  { src: vdb158, alt: "The faint reflection nebula VdB 158", caption: "VdB 158" },
  { src: iris, alt: "The blue Iris Nebula among dark dust clouds", caption: "Iris Nebula" },
  { src: shark, alt: "The Shark Nebula in a field of stars", caption: "Shark Nebula" },
  { src: jellyfish, alt: "The Jellyfish Nebula glowing against deep space", caption: "Jellyfish Nebula" },
  { src: elephantsTrunk, alt: "The Elephant's Trunk Nebula and surrounding star field", caption: "Elephant's Trunk Nebula" },
  { src: heart, alt: "The Heart Nebula", caption: "Heart Nebula" },
  { src: casper, alt: "The pale Casper the Friendly Ghost Nebula", caption: "Casper the Friendly Ghost Nebula" },
  { src: horsehead, alt: "The Horsehead Nebula silhouetted against glowing gas", caption: "Horsehead Nebula" },
  { src: orion, alt: "The Orion Nebula in the constellation Orion", caption: "Orion Nebula" },
];

const eclipsePhotos: Photo[] = [
  { src: eclipsePalencia, alt: "Solar eclipse photographed in Palencia", caption: "Solar eclipse · Palencia" },
  { src: eclipseSetup0, alt: "Eclipse photography equipment setup, first view", caption: "Observing setup · 01", position: "center 25%" },
  { src: eclipseSetup1, alt: "Eclipse photography equipment setup, second view", caption: "Observing setup · 02" },
  { src: eclipseSetup2, alt: "Eclipse photography equipment setup, third view", caption: "Observing setup · 03" },
  { src: eclipseSetup3, alt: "Eclipse photography equipment setup, fourth view", caption: "Observing setup · 04" },
];

const printArtwork: Photo[] = [
  { src: cdCover, alt: "CD cover artwork for the astrophotography exhibition", caption: "Astrophotography CD cover artwork" },
];
---

<div class="photography-portfolio">
  <p class="photography-portfolio__intro">...</p>

  <nav class="photography-projects" aria-label="Photography projects">
    <a class="photography-project" href="/astrophotography-exhibition/">
      <span class="photography-project__label">Project 01 · Deep sky</span>
      <strong>Astrophotography exhibition</strong>
      <span class="photography-project__open">View project <span aria-hidden="true">→</span></span>
    </a>
    <a class="photography-project" href="/eclipse-photography/">
      <span class="photography-project__label">Project 02 · Solar</span>
      <strong>Eclipse photography</strong>
      <span class="photography-project__open">View project <span aria-hidden="true">→</span></span>
    </a>
  </nav>

  <section class="photography-section" aria-labelledby="deep-sky-title">
    <p class="photography-section__label">01 / Deep sky</p>
    <h2 id="deep-sky-title">Nebulae and distant light</h2>
    <PhotoGallery photos={deepSkyPhotos} />
  </section>

  <section class="photography-section" aria-labelledby="eclipse-title">
    <p class="photography-section__label">02 / Solar</p>
    <h2 id="eclipse-title">Eclipse photography · Palencia</h2>
    <PhotoGallery photos={eclipsePhotos} />
  </section>

  <section class="photography-section" aria-labelledby="print-title">
    <p class="photography-section__label">03 / In print</p>
    <h2 id="print-title">Exhibition artwork</h2>
    <PhotoGallery photos={printArtwork} />
  </section>

  <!--<section class="photography-notes" aria-labelledby="photography-notes-title">
    <p class="photography-section__label">Field notes · Journal</p>
    <h2 id="photography-notes-title">Stories behind the frames</h2>
    <p>Observing notes, image-processing walkthroughs, and stories from the field will be added here.</p>
    <span class="photography-notes__status">Journal in progress</span>
  </section>
   -->
</div>

<style>
  .photography-portfolio__intro {
    max-width: 66ch;
    margin: 0 0 2rem;
    color: var(--muted-strong);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .photography-projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-block: 2rem 3.5rem;
  }

  .photography-project {
    display: flex;
    min-height: 150px;
    flex-direction: column;
    padding: 1.2rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: linear-gradient(145deg, rgb(101 214 173 / 0.055), transparent 60%), var(--bg);
    text-decoration: none;
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .photography-project:hover,
  .photography-project:focus-visible {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .photography-project:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 3px;
  }

  .photography-project__label,
  .photography-project__open,
  .photography-section__label,
  .photography-notes__status {
    color: var(--green);
    font: 0.68rem/1.5 var(--mono);
    letter-spacing: 0.035em;
  }

  .photography-project strong {
    margin-block: 0.75rem auto;
    color: var(--text);
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .photography-section {
    margin-block: 3.5rem;
  }

  .photography-section__label {
    margin: 0 0 0.4rem;
    text-transform: uppercase;
  }

  .photography-section h2,
  .photography-notes h2 {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .photography-notes {
    margin-top: 4rem;
    padding: clamp(1.2rem, 4vw, 2rem);
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
  }

  .photography-notes h2 {
    margin-bottom: 0.7rem;
  }

  .photography-notes > p:not(.photography-section__label) {
    margin-block: 0 1rem;
    color: var(--muted-strong);
  }

  @media (max-width: 580px) {
    .photography-projects {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photography-project {
      transition: none;
    }
  }
</style>
