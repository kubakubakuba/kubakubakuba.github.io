---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeLabel?: string;
  afterLabel?: string;
  caption?: string;
}

const {
  before,
  after,
  beforeLabel = "Before",
  afterLabel = "After",
  caption,
} = Astro.props;

const comparisonId = `image-comparison-${before.src.replace(/[^a-z0-9]/gi, "").slice(-16) || "image"}`;
---

<figure class="image-comparison" data-comparison={comparisonId} style="--comparison-position: 50%;">
  <div class="image-comparison__viewport">
    <Image
      src={after}
      format="avif"
      alt={afterLabel}
      widths={[640, 960, 1280, 1600]}
      sizes="(max-width: 760px) 100vw, 960px"
      class="image-comparison__image"
      loading="lazy"
      decoding="async"
    />
    <Image
      src={before}
      format="avif"
      alt=""
      aria-hidden="true"
      widths={[640, 960, 1280, 1600]}
      sizes="(max-width: 760px) 100vw, 960px"
      class="image-comparison__image image-comparison__image--before"
      loading="lazy"
      decoding="async"
    />
    <div class="image-comparison__labels" aria-hidden="true">
      <span>{beforeLabel}</span>
      <span>{afterLabel}</span>
    </div>
    <div class="image-comparison__handle" aria-hidden="true"></div>
    <label class="image-comparison__control">
      <span class="image-comparison__sr-only">Show more of the {beforeLabel} image</span>
      <input type="range" min="0" max="100" value="50" aria-label={`Compare ${beforeLabel} and ${afterLabel}`} />
    </label>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  document.querySelectorAll<HTMLElement>("[data-comparison]").forEach((comparison) => {
    const input = comparison.querySelector<HTMLInputElement>("input[type='range']");
    if (!input) return;

    const updatePosition = () => {
      comparison.style.setProperty("--comparison-position", input.value + "%");
    };

    input.addEventListener("input", updatePosition);
    updatePosition();
  });
</script>

<style>
  .image-comparison {
    max-width: 100%;
    margin-block: clamp(2rem, 7vw, 4.5rem);
  }

  .image-comparison__viewport {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--bg);
    isolation: isolate;
  }

  .image-comparison__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .image-comparison__image--before {
    clip-path: inset(0 calc(100% - var(--comparison-position)) 0 0);
  }

  .image-comparison__labels {
    position: absolute;
    z-index: 1;
    top: 0.75rem;
    right: 0.75rem;
    left: 0.75rem;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .image-comparison__labels span {
    padding: 0.28rem 0.5rem;
    border: 1px solid rgb(55 71 84 / 0.9);
    border-radius: 4px;
    color: var(--text);
    background: rgb(9 13 18 / 0.78);
    font: 0.68rem var(--mono);
  }

  .image-comparison__handle {
    position: absolute;
    z-index: 2;
    top: 0;
    bottom: 0;
    left: var(--comparison-position);
    width: 2px;
    background: var(--green);
    box-shadow: 0 0 0 1px rgb(9 13 18 / 0.55), 0 0 14px rgb(101 214 173 / 0.45);
    pointer-events: none;
    transform: translateX(-1px);
  }

  .image-comparison__handle::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--green);
    border-radius: 50%;
    background: var(--bg);
    color: var(--green);
    content: "↔";
    font: 1rem/1.85 var(--mono);
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .image-comparison__control {
    position: absolute;
    z-index: 3;
    inset: 0;
    cursor: ew-resize;
  }

  .image-comparison__control input {
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: inherit;
  }

  .image-comparison__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    padding: 0;
    border: 0;
    margin: -1px;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .image-comparison figcaption {
    margin-top: 0.7rem;
    color: var(--muted);
    font: 0.7rem/1.5 var(--mono);
    text-align: center;
  }
</style>
