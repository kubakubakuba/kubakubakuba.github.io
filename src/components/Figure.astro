---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  portrait?: boolean;
}

const { src, alt, caption, portrait = false } = Astro.props;
---

<figure class:list={["content-figure", { "content-figure--portrait": portrait }]}>
  <Image
    src={src}
    alt={alt}
    widths={[480, 768, 1080, 1440]}
    sizes={portrait ? "(max-width: 760px) 100vw, 720px" : "(max-width: 760px) 100vw, 960px"}
    loading="lazy"
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
