  <g stroke="#273440" stroke-width="1">
    <path d="M40 70H680M40 130H680M40 190H680M40 250H680M40 310H680M40 370H680" />
    <path d="M80 30V390M160 30V390M240 30V390M320 30V390M400 30V390M480 30V390M560 30V390M640 30V390" />
  </g>
  <path d="M74 344L280 168L485 287L650 84" fill="none" stroke="url(#thesis-grid)" stroke-width="2" />
  <g fill="#65d6ad" opacity="0.2" filter="url(#thesis-glow)">
    <circle cx="280" cy="168" r="22" /><circle cx="485" cy="287" r="22" /><circle cx="650" cy="84" r="22" />
  </g>
  <g fill="#65d6ad">
    <circle cx="74" cy="344" r="5" /><circle cx="280" cy="168" r="7" /><circle cx="485" cy="287" r="7" /><circle cx="650" cy="84" r="7" />
