  </g>
  <text x="55" y="55" fill="#7d8b98" font-family="CommitMono, monospace" font-size="13">EVENT STREAM / RELATIVE POSE</text>
  <text x="515" y="370" fill="#65d6ad" font-family="CommitMono, monospace" font-size="12">x  y  z  θ</text>
</svg>
