---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Photo {
  src: ImageMetadata;
  alt: string;
  caption: string;
  position?: string;
  fit?: "cover" | "contain";
}

interface Props {
  photos: Photo[];
  lead?: Photo;
}

const { photos, lead } = Astro.props;
const allPhotos = lead ? [lead, ...photos] : photos;
const galleryId = `gallery-${allPhotos[0]?.src.src.replace(/[^a-z0-9]/gi, "").slice(-20) || "photos"}-${allPhotos.length}`;
---

<div class="photo-gallery">
  {lead && (
    <figure class="photo-gallery__lead">
      <a
        class:list={["photo-gallery__image", { "photo-gallery__image--contain": lead.fit === "contain" }]}
        href={lead.src.src}
        aria-label={"Enlarge image: " + lead.caption}
        data-lightbox
        data-lightbox-group={galleryId}
        data-lightbox-description={lead.caption}
        style={`--photo-position: ${lead.position ?? "center"}`}
      >
        <Image
          src={lead.src}
          alt={lead.alt}
          widths={[768, 1080, 1440, 1920, 2400]}
          sizes="(max-width: 760px) 100vw, 840px"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </a>
      <figcaption>{lead.caption}</figcaption>
    </figure>
  )}

  <div class="photo-gallery__grid">
    {photos.map((photo) => (
      <figure class="photo-gallery__item">
      <a
        class:list={["photo-gallery__image", { "photo-gallery__image--contain": photo.fit === "contain" }]}
        href={photo.src.src}
        aria-label={"Enlarge image: " + photo.caption}
        data-lightbox
        data-lightbox-group={galleryId}
        data-lightbox-description={photo.caption}
        style={`--photo-position: ${photo.position ?? "center"}`}
      >
        <Image
          src={photo.src}
          alt={photo.alt}
          widths={[480, 768, 1200, 1600, 1920, 2400]}
          sizes="(max-width: 640px) 50vw, (max-width: 980px) 33vw, 280px"
          loading="lazy"
          decoding="async"
        />
      </a>
      <figcaption>{photo.caption}</figcaption>
      </figure>
    ))}
  </div>
</div>

<style>
  .photo-gallery {
    margin-block: 1.5rem 3rem;
  }

  .photo-gallery__lead {
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
  }

  .photo-gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: clamp(0.8rem, 2vw, 1.2rem);
  }

  .photo-gallery__item {
    min-width: 0;
    margin: 0;
  }

  .photo-gallery__image {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    cursor: zoom-in;
  }

  .photo-gallery__image:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 3px;
  }

  .photo-gallery__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--photo-position);
    transition: transform 250ms ease;
  }

  .photo-gallery__image--contain img {
    object-fit: contain;
    background: var(--panel);
  }

  .photo-gallery__image:hover img {
    transform: scale(1.035);
  }

  .photo-gallery__item figcaption {
    margin-top: 0.55rem;
    color: var(--muted);
    font: 0.68rem/1.5 var(--mono);
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-gallery__image img {
      transition: none;
    }
  }
</style>
