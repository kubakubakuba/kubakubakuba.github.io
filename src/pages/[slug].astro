---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import MathStyles from "../components/MathStyles.astro";
import BachelorMedia from "../components/BachelorMedia.astro";
import WindowBar from "../components/WindowBar.astro";
import Icon from "../components/Icon.astro";

export async function getStaticPaths() {
  const [work, pages] = await Promise.all([getCollection("work"), getCollection("pages")]);
  return [
    ...work.map((entry) => ({ params: { slug: entry.data.slug } })),
    ...pages.map((entry) => ({ params: { slug: entry.data.slug } })),
  ];
}

const slug = Astro.params.slug;
const workEntries = await getCollection("work");
const pageEntries = await getCollection("pages");
const workEntry = workEntries.find((entry) => entry.data.slug === slug);
const pageEntry = pageEntries.find((entry) => entry.data.slug === slug);

if (!workEntry && !pageEntry) return Astro.redirect("/404/");

let Content;
let title: string;
let heading: string;
let description: string;
let windowTitle: string;
let windowLabel: string | undefined;
let showDescription: boolean;

if (workEntry) {
  ({ Content } = await render(workEntry));
  title = workEntry.data.title;
  heading = workEntry.data.title;
  description = workEntry.data.summary;
  windowTitle = `jakub@web:~/work/${slug}`;
  windowLabel = `${workEntry.data.kind} · ${workEntry.data.yearLabel}`;
  showDescription = true;
} else {
  ({ Content } = await render(pageEntry!));
  title = pageEntry!.data.title;
  heading = pageEntry!.data.heading ?? pageEntry!.data.title;
  description = pageEntry!.data.description;
  windowTitle = `jakub@web:~/${slug}`;
  showDescription = pageEntry!.data.showDescription;
}
---

<BaseLayout title={title} description={description}>
  {slug === "bachelor" && <MathStyles />}
  <article class:list={["window", "article-page", `article-page--${slug}`]}>
    <WindowBar title={windowTitle} label={windowLabel} />
    <div class="window__body">
      {workEntry && <a class="back-link" href="/#work"><Icon name="arrow-left" /> cd ..</a>}
      <header class:list={["article-header", { "article-header--compact": !showDescription }]}>
        <h1>{heading}</h1>
        {showDescription && <p>{description}</p>}
        {workEntry && (
          <div class="metadata">
            <span>{workEntry.data.kind}</span>
            <span>{workEntry.data.yearLabel}</span>
            <span>/{workEntry.data.slug}/</span>
          </div>
        )}
      </header>
      {workEntry?.data.showVisual && (
        <div class="article-project-visual">
          <ProjectVisual visual={workEntry.data.visual} eager />
        </div>
      )}
      <div class="prose">
        <Content />
        {slug === "bachelor" && <BachelorMedia />}
      </div>
    </div>
  </article>
</BaseLayout>
